{
  "name": "web-cpp-tool",
  "displayName": "WebC++ — C++ in the Browser (WASM)",
  "description": "在 VS Code for the Web（vscode.dev / 自托管）里写、跑、调试 C++：WASM Clang 编译、真实终端交互运行、clangd 补全，以及源码级断点调试（wdb）。",
  "version": "0.2.1",
  "publisher": "web-cpp-tool",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Education",
    "Other"
  ],
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:oiCpp.runInTerminal",
    "onCommand:oiCpp.debug",
    "onCommand:oiCpp.openFolder",
    "onDebugResolve:oi-cpp-wasm"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "oiCpp.runInTerminal",
        "title": "WebC++: 编译并在终端运行",
        "icon": "$(play)"
      },
      {
        "command": "oiCpp.runTerminal",
        "title": "WebC++: 打开运行终端"
      },
      {
        "command": "oiCpp.restartLsp",
        "title": "WebC++: 重启 clangd(WASM)"
      },
      {
        "command": "oiCpp.debug",
        "title": "WebC++: 开始调试（WASM）",
        "icon": "$(debug-alt)"
      },
      {
        "command": "oiCpp.toggleBreakpoint",
        "title": "WebC++: 切换断点（当前行）",
        "icon": "$(circle-filled)"
      },
      {
        "command": "oiCpp.openFolder",
        "title": "WebC++: 打开本地文件夹（浏览器）",
        "icon": "$(folder-opened)"
      },
      {
        "command": "oiCpp.refreshFolder",
        "title": "WebC++: 刷新本地文件夹"
      },
      {
        "command": "oiCpp.showLogs",
        "title": "WebC++: 显示日志"
      },
      {
        "command": "oiCpp.copyLogs",
        "title": "WebC++: 复制日志"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "oiCpp.runInTerminal",
          "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/",
          "group": "navigation@1"
        },
        {
          "command": "oiCpp.debug",
          "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "oiCpp.runInTerminal",
          "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/"
        },
        {
          "command": "oiCpp.debug",
          "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/"
        },
        {
          "command": "oiCpp.toggleBreakpoint",
          "when": "editorTextFocus"
        },
        {
          "command": "oiCpp.openFolder",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "oiCpp.toggleBreakpoint",
          "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/",
          "group": "navigation@9"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "oiCpp.toggleBreakpoint",
          "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "oiCpp.runInTerminal",
        "key": "ctrl+shift+b",
        "when": "resourceExtname =~ /^\\.(cpp|cc|cxx|c)$/"
      },
      {
        "command": "oiCpp.toggleBreakpoint",
        "key": "f9",
        "when": "editorTextFocus && !inDebugRepl"
      }
    ],
    "configuration": {
      "title": "WebC++ (WASM)",
      "properties": {
        "oiCpp.flags": {
          "type": "string",
          "default": "-std=c++20 -DLOCAL",
          "description": "传给编译器的参数"
        },
        "oiCpp.opt": {
          "type": "number",
          "default": 2,
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "oiCpp.debugInfo": {
          "type": "boolean",
          "default": true,
          "description": "生成 DWARF 调试信息（-g），便于 DevTools 调试；会让编译慢一些"
        },
        "oiCpp.verbose": {
          "type": "boolean",
          "default": false,
          "description": "在终端里显示工具链加载等详细日志"
        },
        "oiCpp.lsp": {
          "type": "boolean",
          "default": true,
          "description": "启用 clangd(WASM) 语言服务：补全、悬浮、跳转、诊断、格式化（首次约下载 24MB）"
        },
        "oiCpp.assetsBaseUrl": {
          "type": "string",
          "default": "",
          "description": "工具链资产（clang/lld/sysroot/clangd）的静态托管根 URL。留空则用扩展自带的 assets/。VSIX 体积超限时可把 assets 外置到这里。"
        }
      }
    },
    "debuggers": [
      {
        "type": "oi-cpp-wasm",
        "label": "WebC++ (WASM)",
        "languages": [
          "cpp",
          "c"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {}
          }
        },
        "initialConfigurations": [
          {
            "type": "oi-cpp-wasm",
            "request": "launch",
            "name": "WebC++ 调试（WASM）"
          }
        ],
        "configurationSnippets": [
          {
            "label": "WebC++ 调试（WASM）",
            "description": "调试当前打开的 C++ 文件（WASM）",
            "body": {
              "type": "oi-cpp-wasm",
              "request": "launch",
              "name": "WebC++ 调试（WASM）"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "cpp"
      },
      {
        "language": "c"
      }
    ]
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "test": "node test/smoke.mjs",
    "test:debug": "node test/debug-instr.mjs",
    "test:session": "node test/debug-session.mjs",
    "test:dap": "node test/dap-flow.mjs",
    "test:client": "node test/dap-trap-flow.mjs && node test/dwarf-client.mjs",
    "test:dwarf": "node test/dwarf-browser-env.mjs",
    "test:eval": "node test/debug-eval.mjs",
    "test:all": "node test/lineedit.mjs && node test/smoke.mjs && node test/debug-instr.mjs && node test/debug-session.mjs && node test/debug-eval.mjs && node test/debug-vars.mjs && node test/debug-stl.mjs && node test/dap-flow.mjs && node test/dwarf-client.mjs && node test/dwarf-browser-env.mjs",
    "test:vars": "node test/debug-vars.mjs",
    "test:lineedit": "node test/lineedit.mjs",
    "test:stl": "node test/debug-stl.mjs",
    "postinstall": "node ../scripts/patch-wasi-shim.mjs",
    "vsix": "node esbuild.mjs && npx --no-install @vscode/vsce package --no-dependencies --allow-missing-repository",
    "publish:marketplace": "node esbuild.mjs && npx --no-install @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "esbuild": "^0.28.2",
    "vscode-languageclient": "^10.1.2",
    "@vscode/vsce": "^3.2.0"
  },
  "icon": "icon.png",
  "keywords": [
    "c++",
    "cpp",
    "wasm",
    "webassembly",
    "clang",
    "clangd",
    "lsp",
    "debug",
    "debugger",
    "dwarf",
    "competitive-programming",
    "oi",
    "vscode-web",
    "no-backend",
    "web-ide"
  ],
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hcz1017/oi-web.git"
  },
  "bugs": {
    "url": "https://github.com/hcz1017/oi-web/issues"
  },
  "homepage": "https://github.com/hcz1017/oi-web#readme",
  "main": "./dist/node/extension.js",
  "extensionKind": [
    "workspace"
  ]
}
